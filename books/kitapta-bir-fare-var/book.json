,"w":"özledin"},"şimdi":{"tr":"şimdi","en":"now","ky":"азыр","ru":"сейчас","w":"Şimdi"}},"sent":{"5.1":{"en":"Hello, my name is Leyla.","ky":"Салам, менин атым Лейла.","ru":"Привет, меня зовут Лейла.","tr":"Merhaba, benim adım Leyla."},"5.2":{"en":"This is my school.","ky":"Бул менин мектебим.","ru":"Это моя школа.","tr":"Burası benim okulum."},"6.1":{"en":"There are classrooms at school.","ky":"Мектепте класстар бар.","ru":"В школе есть классы.","tr":"Okulda sınıflar var."},"6.2":{"en":"There are desks in the classroom.","ky":"Класста парталар бар.","ru":"В классе есть парты.","tr":"Sınıfta sıralar var."},"6.3":{"en":"There are books on the desk.","ky":"Партада китептер бар.","ru":"На парте есть книги.","tr":"Sırada kitaplar var."},"7.1":{"en":"My books are here.","ky":"Менин китептерим бул жерде.","ru":"Мои книги здесь.","tr":"Kitaplarım burada."},"7.2":{"en":"The blue book is on the desk.","ky":"Көк китеп партада.","ru":"Синяя книга на парте.","tr":"Mavi kitap sırada."},"7.3":{"en":"The yellow book is in my hand.","ky":"Сары китеп колумда.","ru":"Жёлтая книга у меня в руке.","tr":"Sarı kitap elimde."},"8.1":{"en":"The bell is ringing.","ky":"Коңгуроо шыңгырап жатат.","ru":"Звенит звонок.","tr":"Zil çalıyor."},"8.2":{"en":"Now it's time to go home!","ky":"Эми үйгө баруу убактысы!","ru":"Пора идти домой!","tr":"Şimdi eve gitme zamanı!"},"9.1":{"en":"This is my home.","ky":"Бул менин үйүм.","ru":"Это мой дом.","tr":"Burası benim evim."},"9.2":{"en":"My mom is opening the door.","ky":"Апам эшикти ачып жатат.","ru":"Мама открывает дверь.","tr":"Annem kapıyı açıyor."},"9.3":{"en":"Welcome, Leyla!","ky":"Кош келдиң, Лейла!","ru":"Добро пожаловать, Лейла!","tr":"Hoş geldin Leyla."},"9.4":{"en":"Thank you, Mom! (reply to “Welcome”)","ky":"Кош көрдүк, апа!","ru":"Спасибо, мама! (ответ на «добро пожаловать»)","tr":"Hoş bulduk anne."},"10.1":{"en":"Hello, Piti!","ky":"Салам, Пити!","ru":"Привет, Пити!","tr":"Merhaba Piti!"},"10.2":{"en":"Did you miss me?","ky":"Мени сагындыңбы?","ru":"Ты скучал по мне?","tr":"Beni özledin mi?"},"10.m":{"en":"Meow!","ky":"Мыяў!","ru":"Мяу!","tr":"Miyavvvv!"},"11.1":{"en":"They are my family.","ky":"Алар менин үй-бүлөм.","ru":"Это моя семья.","tr":"Onlar benim ailem."},"11.2":{"en":"My grandpa is drinking tea.","ky":"Чоң атам чай ичип жатат.","ru":"Дедушка пьёт чай.","tr":"Dedem çay içiyor."},"11.3":{"en":"My dad is reading the newspaper.","ky":"Атам гезит окуп жатат.","ru":"Папа читает газету.","tr":"Babam gazete okuyor."},"11.4":{"en":"My little brother is playing with a ball.","ky":"Иним топ ойноп жатат.","ru":"Мой брат играет в мяч.","tr":"Kardeşim top oynuyor."},"12.1":{"en":"This is the living room.","ky":"Бул конок бөлмө.","ru":"Это гостиная.","tr":"Burası salon."},"12.2":{"en":"In the living room there is a sofa, a table and a bookshelf.","ky":"Конок бөлмөдө диван, стол жана китеп текчеси бар.","ru":"В гостиной есть диван, стол и книжный шкаф.","tr":"Salonda koltuk, masa, kitaplık var."},"12.3":{"en":"There are many books on the bookshelf.","ky":"Китеп текчесинде китептер көп.","ru":"В книжном шкафу много книг.","tr":"Kitaplıkta çok kitap var."},"13.1":{"en":"My little brother loves books very much.","ky":"Иним китептерди абдан жакшы көрөт.","ru":"Мой брат очень любит книги.","tr":"Kardeşim kitapları çok seviyor."},"13.2":{"en":"He shows me the yellow book.","ky":"Ал мага сары китепти көрсөтүп жатат.","ru":"Он показывает мне жёлтую книгу.","tr":"Bana sarı kitabı gösteriyor."},"13.3":{"en":"Now it's story time!","ky":"Эми жомок убактысы!","ru":"Теперь время сказки!","tr":"Şimdi masal zamanı!"},"14.1":{"en":"There is a mouse in the book.","ky":"Китепте бир чычкан бар.","ru":"В книге есть мышка.","tr":"Kitapta bir fare var."},"14.2":{"en":"Piti is coming to us.","ky":"Пити биздин жаныбызга келе жатат.","ru":"Пити идёт к нам.","tr":"Piti yanımıza geliyor."},"14.3":{"en":"The mouse is afraid of Piti.","ky":"Чычкан Питиден коркуп жатат.","ru":"Мышка боится Пити.","tr":"Fare Piti’den korkuyor."},"14.4":