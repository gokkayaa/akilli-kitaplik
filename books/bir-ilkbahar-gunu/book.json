n":"place (everywhere)","ky":"жерде","ru":"везде","cog":"жерде","w":"yerde"},"yere":{"tr":"yer + e","en":"to the ground","ky":"жерге","ru":"на землю","cog":"жерге","w":"yere"},"yerin_altına":{"tr":"kalıp söz","en":"under the ground","ky":"жердин астына","ru":"под землю","cog":"жер","w":"yerin altına"},"yerler":{"tr":"yer + ler","en":"the ground","ky":"жерлер","ru":"земля","cog":"жерлер","w":"Yerler"},"yeşil":{"tr":"renk","en":"green","ky":"жашыл","ru":"зелёный","cog":"жашыл","w":"Yeşil"},"yok":{"tr":"yok","en":"there isn't, has no","ky":"жок","ru":"нет","cog":"жок","w":"yok"},"yürüyor":{"tr":"yürümek → yürüyor","en":"walks","ky":"басат","ru":"ходит","w":"yürüyor"},"çimenlere":{"tr":"çimen + ler + e","en":"on the grass","ky":"чөпкө","ru":"на траву","w":"çimenlere"},"çiçekler":{"tr":"çiçek + ler","en":"flowers","ky":"гүлдөр","ru":"цветы","w":"çiçekler"},"çocuklar":{"tr":"çocuk + lar","en":"children","ky":"балдар","ru":"дети","w":"çocuklar"},"çok":{"tr":"çok","en":"very, a lot of","ky":"абдан, көп","ru":"очень, много","w":"çok"},"çünkü":{"tr":"bağlaç","en":"because","ky":"анткени","ru":"потому что","w":"çünkü"},"üzgün":{"tr":"üzgün","en":"sad","ky":"капа","ru":"грустный","w":"üzgün"},"üzülme":{"tr":"üzülmek → üzülme","en":"don't be sad","ky":"капа болбо","ru":"не грусти","w":"Üzülme"},"şurada":{"tr":"şura + da","en":"over there","ky":"тигил жерде","ru":"вон там","w":"şurada"}},"sent":{"5.1":{"en":"Today is Sunday.","ky":"Бүгүн жекшемби.","ru":"Сегодня воскресенье.","tr":"Bugün günlerden pazar."},"5.2":{"en":"The season is spring.","ky":"Мезгил – жаз.","ru":"Время года – весна.","tr":"Mevsim ilkbahar."},"5.3":{"en":"There are flowers everywhere.","ky":"Бардык жерде гүлдөр бар.","ru":"Везде цветы.","tr":"Her yerde çiçekler var."},"5.4":{"en":"I am happy because I am going to the park.","ky":"Мен бактылуумун, анткени паркка бара жатам.","ru":"Я счастлива, потому что иду в парк.","tr":"Mutluyum çünkü parka gidiyorum."},"5.5":{"en":"Piti is going to the park too.","ky":"Пити да паркка бара жатат.","ru":"Пити тоже идёт в парк.","tr":"Piti de parka gidiyor."},"6.1":{"en":"This is the park.","ky":"Бул – парк.","ru":"Это парк.","tr":"Burası park."},"6.2":{"en":"There are children in the park.","ky":"Паркта балдар бар.","ru":"В парке есть дети.","tr":"Parkta çocuklar var."},"6.3":{"en":"This is the sandpit.","ky":"Бул – кум аянтчасы.","ru":"Это песочница.","tr":"Bu, kum havuzu."},"6.4":{"en":"The slide is over there.","ky":"Тайгалак тигил жерде.","ru":"Горка вон там.","tr":"Kaydırak şurada."},"6.5":{"en":"The swing is there.","ky":"Селкинчек ал жерде.","ru":"Качели там.","tr":"Salıncak orada."},"7.1":{"en":"Piti is sitting in the sandpit.","ky":"Пити кум аянтчасында отурат.","ru":"Пити сидит в песочнице.","tr":"Piti kum havuzunda oturuyor."},"7.2":{"en":"He is sad.","ky":"Ал капа.","ru":"Он грустный.","tr":"O üzgün."},"7.3":{"en":"Because Piti has no friend.","ky":"Анткени Питинин досу жок.","ru":"Потому что у Пити нет друга.","tr":"Çünkü Piti’nin arkadaşı yok."},"7.4":{"en":"Don't be sad, Piti, there are lots of friends in the park!","ky":"Капа болбо, Пити, паркта достор көп!","ru":"Не грусти, Пити, в парке много друзей!","tr":"Üzülme Piti, parkta çok arkadaş var!"},"8.1":{"en":"Look, there is an ant there.","ky":"Кара, тигил жерде кумурска бар.","ru":"Смотри, там муравей.","tr":"Bak, orada karınca var."},"8.2":{"en":"Let's say \"hello\" to the little ant.","ky":"Кичинекей кумурскага «салам» дейли.","ru":"Давай скажем маленькому муравью «привет».","tr":"Küçük karıncaya “merhaba” diyelim."},"8.3":{"en":"Hello, ant.","ky":"Салам, кумурска.","ru":"Привет, муравей.","tr":"Merhaba karınca."},"9.1":{"en":"Oh, the ant is going under the ground!","ky":"Оо, кумурска жердин астына кирип жатат!","ru":"Ой, муравей уходит под землю!","tr":"Aa, karınca yerin altına giriyor!"},"10.1":{"en":"Look, there is a sparrow in the tree.","ky":"Кара, даракта таранчы бар.","ru":"Смотри, на дереве воробей.","tr":"Bak, ağaçta serçe var."},"10.2":{"en":"Let's say \"hello\" to the sparrow.","ky":"Таранчыга «салам» дейли.","ru":"Давай скажем воробью «привет».","tr":"Serçeye “merhaba” diyelim."},"10.3":{"en":"\"Hello, sparrow.\"","ky":"«Салам, таранчы».","ru":"«Привет, воробей».","tr":"“Merhaba serçe.”"},"11.1":{"en":"Oh, the sparrow is very fast!","ky":"Оо, таранчы абдан тез!","ru":"Ой, воробей очень быстрый!","tr":"Aa, serçe çok hızlı!"},"11.2":{"en":"It is flying to the sky.","ky":"Ал асманга учуп жатат.","ru":"Он улетает в небо.","tr":"O, gökyüzüne uçuyor."},"12.1":{"en":"Look, there is a tortoise here.","ky":"Кара, бул жерде ташбака бар.","ru":"Смотри, здесь черепаха.","tr":"Bak, burada kaplumbağa var."},"12.2":{"en":"The tortoise walks very slowly.","ky":"Ташбака абдан жай басат.","ru":"Черепаха ходит очень медленно.","tr":"Kaplumbağa çok yavaş yürüyor."},"12.3":{"en":"Let's say \"hello\" to the tortoise.","ky":"Ташбакага «салам» дейли.","ru":"Давай скажем черепахе «привет».","tr":"Kaplumbağaya “merhaba” diyelim."},"12.4":{"en":"\"Hello, tortoise!\"","ky":"«Салам, ташбака!»","ru":"«Привет, черепаха!»","tr":"“Merhaba kaplumbağa!”"},"13.1":{"en":"Oh, the tortoise is inside its shell!","ky":"Оо, ташбака кабыгынын ичинде!","ru":"Ой, черепаха спряталась в панцирь!","tr":"Aa, kaplumbağa kabuğun içinde!"},"13.2":{"en":"It doesn't talk to us.","ky":"Ал биз менен сүйлөбөйт.","ru":"Она с нами не разговаривает.","tr":"Bizimle konuşmuyor."},"14.1":{"en":"A drop falls from the sky to the ground.","ky":"Асмандан жерге бир тамчы түшөт.","ru":"С неба на землю падает капля.","tr":"Gökyüzünden bir damla yere düşüyor."},"14.2":{"en":"Then two drops fall.","ky":"Анан эки тамчы түшөт.","ru":"Потом падают две капли.","tr":"Sonra iki damla düşüyor."},"14.3":{"en":"Then five drops fall.","ky":"Анан беш тамчы түшөт.","ru":"Потом падают пять капель.","tr":"Sonra beş damla düşüyor."},"14.4":{"en":"Oh, it's raining!","ky":"Оо, жамгыр жаап жатат!","ru":"Ой, идёт дождь!","tr":"Aa, yağmur yağıyor!"},"14.5":{"en":"Come on, Piti, let's dance in the rain!","ky":"Кел, Пити, жамгырда бийлейли!","ru":"Иди сюда, Пити, давай танцевать под дождём!","tr":"Hadi gel Piti, yağmurda dans edelim!"},"15.p1":{"en":"The rain is falling drop by drop,","ky":"Жамгыр тамчы-тамчы жаап жатат,","ru":"Дождь идёт капля за каплей,","tr":"Yağmur yağıyor damla damla,"},"15.p2":{"en":"Piti is playing with the mud.","ky":"Пити ылай менен ойноп жатат.","ru":"Пити играет с грязью.","tr":"Piti oynuyor çamurla."},"15.p3":{"en":"Don't stand still, go out to the park too.","ky":"Сен да туруп калба, паркка чык.","ru":"И ты не стой, выходи в парк.","tr":"Sen de durma, parka çık."},"15.p4":{"en":"Life is lovely with the rain.","ky":"Жамгыр менен жашоо сонун.","ru":"С дождём жизнь прекрасна.","tr":"Hayat güzel yağmurla."},"16.1":{"en":"The rain went away, the sun came.","ky":"Жамгыр токтоду, күн чыкты.","ru":"Дождь прошёл, вышло солнце.","tr":"Yağmur gitti, güneş geldi."},"16.2":{"en":"The ground got dry.","ky":"Жер кургады.","ru":"Земля высохла.","tr":"Yerler kurudu."},"16.3":{"en":"Hello, sun, welcome!","ky":"Салам, күн, кош келдиң!","ru":"Привет, солнце, добро пожаловать!","tr":"Merhaba güneş, hoş geldin!"},"17.1":{"en":"Come on, Piti, let's lie down on the grass.","ky":"Кел, Пити, чөпкө жаталы.","ru":"Иди сюда, Пити, давай ляжем на траву.","tr":"Hadi gel Piti, çimenlere yatalım."},"17.2":{"en":"Let's look at the sky.","ky":"Асманга карайлы.","ru":"Давай посмотрим на небо.","tr":"Gökyüzüne bakalım."},"18.1":{"en":"Piti, look, there is a rainbow there!","ky":"Пити, кара, тигил жерде асан-үсөн бар!","ru":"Пити, смотри, там радуга!","tr":"Piti, bak orada gökkuşağı var!"},"18.2":{"en":"Which colour do you like?","ky":"Сен кайсы түстү жакшы көрөсүң?","ru":"Какой цвет ты любишь?","tr":"Sen hangi rengi seviyorsun?"},"18.3":{"en":"I like blue.","ky":"Мен көк түстү жакшы көрөм.","ru":"Я люблю синий цвет.","tr":"Ben mavi rengi seviyorum."},"18.4":{"en":"Because blue is the colour of the sky.","ky":"Анткени көк – асмандын түсү.","ru":"Потому что синий – цвет неба.","tr":"Çünkü mavi, gökyüzünün rengi."},"19.1":{"en":"The ant is coming here.","ky":"Кумурска бул жакка келе жатат.","ru":"Муравей идёт сюда.","tr":"Karınca buraya geliyor."},"19.2":{"en":"Welcome, ant!","ky":"Кош келдиң, кумурска!","ru":"Добро пожаловать, муравей!","tr":"Hoş geldin karınca!"},"19.3":{"en":"Come on, tell me.","ky":"Кана, мага айт.","ru":"Ну-ка, скажи мне.","tr":"Hadi söyle bana."},"19.4":{"en":"Which colour do you like?","ky":"Сен кайсы түстү жакшы көрөсүң?","ru":"Какой цвет ты любишь?","tr":"Sen hangi rengi seviyorsun?"},"19.5":{"en":"Brown.","ky":"Күрөң.","ru":"Коричневый.","tr":"Kahverengi."},"19.6":{"en":"Because brown is the colour of the soil.","ky":"Анткени күрөң – топурактын түсү.","ru":"Потому что коричневый – цвет земли.","tr":"Çünkü kahverengi, toprağın rengi."},"20.1":{"en":"Welcome, sparrow.","ky":"Кош келдиң, таранчы.","ru":"Добро пожаловать, воробей.","tr":"Hoş geldin serçe."},"20.2":{"en":"Which colour do you like?","ky":"Сен кайсы түстү жакшы көрөсүң?","ru":"Какой цвет ты любишь?","tr":"Sen hangi rengi seviyorsun?"},"20.3":{"en":"I like yellow.","ky":"Мен сары түстү жакшы көрөм.","ru":"Я люблю жёлтый цвет.","tr":"Sarı rengi seviyorum."},"20.4":{"en":"Because yellow is the colour of the sun.","ky":"Анткени сары – күндүн түсү.","ru":"Потому что жёлтый – цвет солнца.","tr":"Çünkü sarı, güneşin rengi."},"21.1":{"en":"The tortoise is here too.","ky":"Ташбака да бул жерде.","ru":"Черепаха тоже здесь.","tr":"Kaplumbağa da burada."},"21.2":{"en":"Welcome, tortoise.","ky":"Кош келдиң, ташбака.","ru":"Добро пожаловать, черепаха.","tr":"Hoş geldin kaplumbağa."},"21.3":{"en":"Which colour do you like?","ky":"Сен кайсы түстү жакшы көрөсүң?","ru":"Какой цвет ты любишь?","tr":"Sen hangi rengi seviyorsun?"},"21.4":{"en":"I like green.","ky":"Мен жашыл түстү жакшы көрөм.","ru":"Я люблю зелёный цвет.","tr":"Yeşil rengi seviyorum."},"21.5":{"en":"Because green is the colour of the leaves.","ky":"Анткени жашыл – жалбырактардын түсү.","ru":"Потому что зелёный – цвет листьев.","tr":"Çünkü yeşil, yaprakların rengi."},"22.p1":{"en":"Yellow, blue, green, brown.","ky":"Сары, көк, жашыл, күрөң.","ru":"Жёлтый, синий, зелёный, коричневый.","tr":"Sarı, mavi, yeşil, kahverengi."},"22.p2":{"en":"Our world is so colourful.","ky":"Дүйнөбүз түркүн түстүү.","ru":"Наш мир такой разноцветный.","tr":"Dünyamız renkli renkli."},"22.p3":{"en":"Come on, you look around too.","ky":"Кана, сен да тегерегиңе кара.","ru":"Давай, и ты посмотри вокруг.","tr":"Haydi sen de etrafına bak."},"22.p4":{"en":"Show us the colours.","ky":"Бизге түстөрдү көрсөт.","ru":"Покажи нам цвета.","tr":"Göster bize renkleri."}},"host":{"name":"Leyla","face":"pic-leyla.jpg"},"quiz":[{"id":"q1","after":5,"type":"mc","q":"Bugün hangi gün?","qt":{"en":"What day is it today?","ky":"Бүгүн кайсы күн?","ru":"Какой сегодня день?"},"options":[{"t":"Pazar","tt":{"en":"Sunday","ky":"Жекшемби","ru":"Воскресенье"}},{"t":"Pazartesi","tt":{"en":"Monday","ky":"Дүйшөмбү","ru":"Понедельник"}},{"t":"Cuma","tt":{"en":"Friday","ky":"Жума","ru":"Пятница"}}],"answer":0,"find":{"page":5,"s":"5.1"}},{"id":"q2","after":7,"type":"tf","q":"Piti mutlu.","qt":{"en":"Piti is happy.","ky":"Пити бактылуу.","ru":"Пити счастлив."},"options":[{"t":"Doğru","tt":{"en":"True","ky":"Туура","ru":"Верно"}},{"t":"Yanlış","tt":{"en":"False","ky":"Туура эмес","ru":"Неверно"}}],"answer":1,"find":{"page":7,"s":"7.2"}},{"id":"q3","after":13,"type":"who","q":"Kim çok yavaş yürüyor?","qt":{"en":"Who walks very slowly?","ky":"Ким абдан жай басат?","ru":"Кто ходит очень медленно?"},"options":[{"t":"Kaplumbağa","tt":{"en":"The tortoise","ky":"Ташбака","ru":"Черепаха"},"face":"pic-kaplumbaga.jpg"},{"t":"Serçe","tt":{"en":"The sparrow","ky":"Таранчы","ru":"Воробей"},"face":"pic-serce.jpg"},{"t":"Karınca","tt":{"en":"The ant","ky":"Кумурска","ru":"Муравей"},"face":"pic-karinca.jpg"}],"answer":0,"find":{"page":12,"s":"12.2"}},{"id":"q4","after":13,"type":"predict","q":"Sence şimdi ne olacak?","qt":{"en":"What do you think will happen now?","ky":"Сенин оюңча, эми эмне болот?","ru":"Как ты думаешь, что сейчас случится?"},"options":[{"t":"Yağmur yağacak.","face":"pic-yagmur.jpg","tt":{"en":"It will rain.","ky":"Жамгыр жаайт.","ru":"Пойдёт дождь."}},{"t":"Kar yağacak.","tt":{"en":"It will snow.","ky":"Кар жаайт.","ru":"Пойдёт снег."}},{"t":"Gece olacak.","tt":{"en":"Night will come.","ky":"Түн болот.","ru":"Наступит ночь."}}]},{"id":"q5","after":20,"type":"mc","q":"Serçe hangi rengi seviyor?","qt":{"en":"Which colour does the sparrow like?","ky":"Таранчы кайсы түстү жакшы көрөт?","ru":"Какой цвет любит воробей?"},"options":[{"t":"Sarı","tt":{"en":"Yellow","ky":"Сары","ru":"Жёлтый"}},{"t":"Mavi","tt":{"en":"Blue","ky":"Көк","ru":"Синий"}},{"t":"Yeşil","tt":{"en":"Green","ky":"Жашыл","ru":"Зелёный"}}],"answer":0,"find":{"page":20,"s":"20.3"}},{"id":"q6","after":22,"type":"talk","q":"Sen hangi rengi seviyorsun? Neden?","qt":{"en":"Which colour do you like? Why?","ky":"Сен кайсы түстү жакшы көрөсүң? Эмне үчүн?","ru":"Какой цвет ты любишь? Почему?"},"tip":"Arkadaşına söyle!","tipt":{"en":"Tell your friend!","ky":"Досуңа айт!","ru":"Скажи другу!"}}]}